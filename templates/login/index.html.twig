{% extends 'base.html.twig' %}

{% block title %}Ingresar · Inmobiliaria{% endblock %}

{% block body %}
<div class="pagina-login">
    <header class="encabezado">
        {% include '_marca.html.twig' with {destino: path('publico_catalogo')} %}
    </header>
    <main class="login-contenedor">
        <form class="tarjeta login-tarjeta" action="{{ path('app_login') }}" method="post">
            <div class="login-cabecera">
                <img class="login-logo" src="{{ asset('img/logo.svg') }}" alt="Inmobiliaria" width="220" height="132">
                <h1>Bienvenido</h1>
                <p class="texto-suave">Ingresá con tu email y contraseña de administrador.</p>
            </div>

            {% if error %}
                <div class="alerta alerta-error" role="alert"><span class="alerta-icono" aria-hidden="true">!</span><p>Email o contraseña incorrectos.</p></div>
            {% endif %}

            <div class="campo">
                <label for="username">Email</label>
                <input type="email" id="username" name="_username" value="{{ ultimoEmail }}" required autofocus>
            </div>
            <div class="campo">
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="_password" required>
            </div>
            <button type="submit" class="boton boton-primario">Ingresar</button>
            {# Enlace a la web pública (CU-17), que no necesita sesión #}
            <p class="texto-suave centrado">¿Buscás alquilar? <a href="{{ path('publico_catalogo') }}">Ver propiedades disponibles</a></p>
        </form>
    </main>
</div>
{% endblock %}
