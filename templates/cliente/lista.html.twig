{% extends 'base.html.twig' %}

{% block title %}Clientes · Inmobiliaria{% endblock %}

{% block body %}
{% include 'header.html.twig' with {volver: path('app_panel')} %}
<main class="contenido">
    <div class="titulo">
        <div>
            <h1>Clientes</h1>
            <p class="texto-suave">Propietarios e inquilinos registrados.</p>
        </div>
        {# CU-04: el modal se abre en el navegador, sin ir al servidor #}
        <button type="button" class="boton boton-primario" onclick="document.getElementById('modal-nuevo').showModal()">+ Nuevo cliente</button>
    </div>

    {% include 'mensajes.html.twig' %}

    {# CU-03 Consultar clientes #}
    <section class="tarjeta">
        <div class="tarjeta-cabecera">
            <h2>Listado</h2>
            <span class="texto-suave">{{ clientes|length }} clientes</span>
        </div>
        {% if clientes is empty %}
            <p class="vacio">Todavía no hay clientes registrados.</p>
        {% else %}
            <div class="tabla-contenedor">
                <table class="tabla">
                    <thead>
                        <tr><th>Nombre y apellido</th><th>DNI</th><th>Teléfono</th><th>Email</th><th>Rol</th><th class="derecha">Acciones</th></tr>
                    </thead>
                    <tbody>
                        {% for cliente in clientes %}
                            <tr>
                                <td class="destacado">{{ cliente.nombreCompleto }}</td>
                                <td>{{ cliente.dni }}</td>
                                <td>{{ cliente.telefono }}</td>
                                <td>{{ cliente.email }}</td>
                                <td class="texto-suave">{{ cliente.rol }}</td>
                                <td class="derecha acciones">
                                    <a class="boton boton-chico" href="{{ path('cliente_editar', {id: cliente.id}) }}">Editar</a>
                                    <a class="boton boton-chico boton-peligro" href="{{ path('cliente_confirmar_eliminar', {id: cliente.id}) }}">Eliminar</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
</main>

{# CU-04 Registrar cliente #}
<dialog id="modal-nuevo" class="modal">
    <form action="{{ path('cliente_nuevo') }}" method="post" class="formulario">
        <h2>Nuevo cliente</h2>
        {{ include('cliente/_campos.html.twig', {cliente: null}) }}
        <div class="modal-botones">
            <button type="button" class="boton" onclick="this.closest('dialog').close()">Cancelar</button>
            <button type="submit" class="boton boton-primario">Guardar cliente</button>
        </div>
    </form>
</dialog>

{# CU-05 Modificar cliente #}
{% if editar is defined %}
<dialog id="modal-editar" class="modal">
    <form action="{{ path('cliente_modificar', {id: editar.id}) }}" method="post" class="formulario">
        <h2>Editar cliente</h2>
        {{ include('cliente/_campos.html.twig', {cliente: editar}) }}
        <div class="modal-botones">
            <a class="boton" href="{{ path('cliente_listar') }}">Cancelar</a>
            <button type="submit" class="boton boton-primario">Guardar cambios</button>
        </div>
    </form>
</dialog>
<script>document.getElementById('modal-editar').showModal();</script>
{% endif %}

{# CU-06 Eliminar cliente #}
{% if eliminar is defined %}
<dialog id="modal-eliminar" class="modal">
    <form action="{{ path('cliente_eliminar', {id: eliminar.id}) }}" method="post" class="formulario">
        <h2>Eliminar cliente</h2>
        <p>¿Seguro que querés eliminar a <strong>{{ eliminar.nombreCompleto }}</strong>?</p>
        <p class="texto-suave">No se puede eliminar un cliente que tenga propiedades o contratos asociados.</p>
        <div class="modal-botones">
            <a class="boton" href="{{ path('cliente_listar') }}">No, volver</a>
            <button type="submit" class="boton boton-peligro-lleno">Eliminar</button>
        </div>
    </form>
</dialog>
<script>document.getElementById('modal-eliminar').showModal();</script>
{% endif %}
{% endblock %}
